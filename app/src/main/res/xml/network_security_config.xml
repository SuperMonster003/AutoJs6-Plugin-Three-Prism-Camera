<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust anchors for the plugin's only HTTPS traffic, the in-app update check (appendix D Q42 = (b) / Q45 = (b)),
  which reads the official plugin index on raw.githubusercontent.com and the jsDelivr mirrors.
  GitHub serves some of its hosts (raw.githubusercontent.com, the release assets) with a Let's Encrypt chain that ends at
  ISRG Root X1, which the system store of Android 7.0 (API 24, the plugin's minSdk) lacks; 7.1.1 and later carry it. The
  DER certificate in res/raw is locked by SHA-256 in locks/trust-anchors.lock (TrustAnchorsTest) and only adds to the
  system store, so every other host keeps its platform trust; user-installed CAs stay untrusted, as the platform default
  for targetSdk 24+ already has it. No cleartext permission is granted.
  zh-CN: 插件唯一的 HTTPS 流量 (附录 D Q42 = (b) / Q45 = (b) 应用内更新检查, 在 raw.githubusercontent.com 与 jsDelivr 镜像上读取官方插件索引) 的信任锚. GitHub 的部分主机 (raw.githubusercontent.com,
  Release 资产) 使用终止于 ISRG Root X1 的 Let's Encrypt 证书链, Android 7.0 (API 24, 本插件的 minSdk) 的系统信任库没有该根证书, 7.1.1 起
  才有. res/raw 中的 DER 证书以 SHA-256 锁定在 locks/trust-anchors.lock (TrustAnchorsTest), 只在系统信任库之外追加, 其他主机仍按平台规则
  信任; 用户安装的 CA 仍不信任, 与 targetSdk 24+ 的平台默认一致. 不放开明文流量.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
